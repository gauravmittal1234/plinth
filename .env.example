# Plinth environment variables: NAMES ONLY. Never put a value in this file.
#
# Real values live only where docs/engineering/SETUP_FOR_FOUNDER.md says:
#   .env.local (repo root, gitignored)      local development
#   apps/mobile/.env.json (gitignored)      app values via --dart-define-from-file
#   supabase/functions/.env (gitignored)    local edge-function values
#   Supabase secrets / Vercel env / GitHub Actions secrets for hosted environments
# Never paste a key, token, password or OTP into a chat with any agent.
#
# PUBLIC by design (may ship in a client): NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY (app),
# NEXT_PUBLIC_SENTRY_DSN, NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_TILES_URL.
# Everything else is SERVER-ONLY. ci-guard fails if a secret-key name or pattern
# appears in apps/.

# --- Modes (not secrets; BUILD_PLAN §9, §10) --------------------------------
# fixtures | supabase. Web reads packages/fixtures when "fixtures".
PLINTH_DATA=
# recorded | live. CI always uses recorded AI responses.
AI_MODE=
# mock | live. Stays mock until the founder says go (SETUP 1.1, 4.6).
META_MODE=
# fixtures | live. Live HARERA fetch also needs the harera_live_fetch flag.
PLINTH_FETCH_MODE=
# yes only after the legal memo + HARERA permission letter (SETUP 1.4). The founder sets it.
HARERA_LIVE_FETCH_APPROVED=

# --- Site and domain (SETUP 0.3) ------------------------------------------
# Public base URL, e.g. the placeholder domain plinth.in until confirmed.
NEXT_PUBLIC_SITE_URL=

# --- Supabase: plinth-dev, later staging/prod (SETUP 2.1) -------------------
# Public: project URL and publishable key for web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public: the same values for the app (apps/mobile/.env.json). Empty URL = FIXTURES mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: secret key, used by edge functions that must bypass RLS (webhooks, outbox).
SUPABASE_SECRET_KEY=
# Server only: project ref, DB password, CI access token.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
# Server only: Standard Webhooks secret for the Send-SMS auth hook.
SEND_SMS_HOOK_SECRET=
# Server only: pg_net -> edge function dispatch secret (also stored in Vault).
PLINTH_DISPATCH_SECRET=
# Server only: shared secret for POST /api/revalidate (ISR tags).
REVALIDATE_SECRET=
# Pipelines: connection string for the pipeline_writer role (never the secret key).
PIPELINE_DB_URL=

# --- WhatsApp: Meta Cloud API (SETUP 1.1) ------------------------------------
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_ID=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
# WhatsApp Flows RSA private key and its passphrase (the public key goes to Meta).
WA_FLOWS_PRIVATE_KEY=
WA_FLOWS_PRIVATE_KEY_PASSPHRASE=
# Public E.164 business number, for wa.me links on /j/ pages.
NEXT_PUBLIC_WA_BUSINESS_NUMBER=

# --- Google Play and Android (SETUP 1.2) -------------------------------------
# GitHub secrets for the signed release workflow (M6).
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
PLAY_SERVICE_ACCOUNT_JSON=
# Vercel env: SHA-256 fingerprints for /.well-known/assetlinks.json (comma-separated).
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- SMS fallback: TRAI DLT + MSG91 (SETUP 1.3) ------------------------------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
# Sender header, e.g. PLINTH.
SMS_SENDER_ID=

# --- Firebase: push and crash reports (SETUP 2.3) ----------------------------
# GitHub secret: base64 of apps/mobile/android/app/google-services.json.
GOOGLE_SERVICES_JSON_BASE64=
# Supabase secret: FCM HTTP v1 service-account JSON (same name as pet_app).
FCM_SERVICE_ACCOUNT=

# --- Gemini (SETUP 2.4). Free tier = fictional data only (DECISIONS E-8) -----
GEMINI_API_KEY=
AI_DAILY_BUDGET_INR=

# --- Sentry and PostHog (SETUP 2.5; no-op when empty) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN_ADMIN=
SENTRY_DSN_EDGE=
SENTRY_DSN_PIPELINES=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_KEY=

# --- Email: Resend (SETUP 3) -------------------------------------------------
RESEND_API_KEY=
# e.g. Plinth <no-reply@plinth.in>
EMAIL_FROM=

# --- Google Cloud: Cloud Run jobs for live fetch, M6 (SETUP 4.3) -------------
GCP_PROJECT_ID=
GCP_REGION=
GCP_WIF_PROVIDER=
GCP_SERVICE_ACCOUNT=

# --- Map tiles: Protomaps PMTiles in Supabase Storage (SETUP 4.4) ------------
NEXT_PUBLIC_TILES_URL=
TILES_URL=

# --- Payments, only if Pro goes on sale (SETUP 4.5) --------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
