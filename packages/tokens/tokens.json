{
  "$description": "Plinth design tokens (DTCG format). Source of truth for dist/tokens.css, dist/theme.css, dist/tokens.ts and dart/lib/*.dart. Inputs: DESIGN.md §0 (overrides the rest), §3.1–§3.5, §3.2b, §4 items 4–7, product/design/review/app-core.md 'Changes shared by all five screens', and the post-taste-pass artboard theme objects. Night values that were translucent in the artboards are flattened to opaque colours over the surface they sit on (DESIGN §0: flat dark ground, no glass). The only translucent values are the photo scrim and the sheet shadow.",
  "$extensions": {
    "in.plinth": {
      "version": "1.0.0"
    }
  },
  "color": {
    "day": {
      "bg": { "$type": "color", "$value": "#FBFAF7", "$description": "Page ground." },
      "bgSolid": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Solid ground inside instruments and fields."
      },
      "panel": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Panel surface. Opaque (artboard panelSolid)."
      },
      "track": {
        "$type": "color",
        "$value": "#F4F2ED",
        "$description": "Tone step: tracks, filled pills, Limited history chip."
      },
      "photo": {
        "$type": "color",
        "$value": "#E7E3DA",
        "$description": "Image placeholder block."
      },
      "claimBg": {
        "$type": "color",
        "$value": "#F1ECE2",
        "$description": "'Developer says' tone field (DESIGN §0 claim-bg)."
      },
      "nav": {
        "$type": "color",
        "$value": "#EFECE5",
        "$description": "App navigation and bottom action bars: a tone step instead of a hairline (app-core.md)."
      },
      "navIndicator": {
        "$type": "color",
        "$value": "#E9F1EC",
        "$description": "Active navigation item indicator (artboard navInd)."
      },
      "header": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Plain sticky top bar. Opaque (artboard headerBg)."
      },
      "sheet": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Bottom sheets, menus, dialogs and drawers: the only surfaces that take a shadow."
      },
      "glass": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Solid circle behind photo controls. Opaque since the taste pass; the artboard name is kept."
      },
      "onGlass": {
        "$type": "color",
        "$value": "#1B1A17",
        "$description": "Icon colour on glass (artboard glassInk)."
      },
      "pressed": {
        "$type": "color",
        "$value": "#E9F1EC",
        "$description": "Pressed or selected row."
      },
      "disabledBg": { "$type": "color", "$value": "#EEEBE4" },
      "disabledFg": { "$type": "color", "$value": "#3F3C36" },
      "line": {
        "$type": "color",
        "$value": "#E7E3DA",
        "$description": "1 px lines for real data tables and form fields only (DESIGN §0)."
      },
      "lineStrong": { "$type": "color", "$value": "#C9C4B9", "$description": "Input borders." },
      "ink": {
        "$type": "color",
        "$value": "#1B1A17",
        "$description": "Primary text and dark buttons."
      },
      "ink2": { "$type": "color", "$value": "#3F3C36", "$description": "Secondary text." },
      "muted": {
        "$type": "color",
        "$value": "#5E5A52",
        "$description": "Genuinely secondary notes only. Running text stays ink (DESIGN §0)."
      },
      "inverse": {
        "$type": "color",
        "$value": "#1B1A17",
        "$description": "Selected filter or choice pill."
      },
      "onInverse": { "$type": "color", "$value": "#FFFFFF" },
      "accent": {
        "$type": "color",
        "$value": "#1D5A44",
        "$description": "The one primary action per screen, the nav indicator and built slabs. Links are ink."
      },
      "onAccent": { "$type": "color", "$value": "#FFFFFF" },
      "accentText": { "$type": "color", "$value": "#1D5A44" },
      "accentStrong": {
        "$type": "color",
        "$value": "#12402F",
        "$description": "Accent hover and pressed (DESIGN §3.1 accent-hover); built-slab edges."
      },
      "accentSoft": {
        "$type": "color",
        "$value": "#E9F1EC",
        "$description": "'What would change this' and info panels."
      },
      "onAccentSoft": { "$type": "color", "$value": "#133D2E" },
      "focus": {
        "$type": "color",
        "$value": "#1D5A44",
        "$description": "Focus ring: 2 px outline, 2 px offset."
      },
      "error": {
        "$type": "color",
        "$value": "#B42318",
        "$description": "System errors only. Never a risk colour."
      },
      "aiLabelBg": {
        "$type": "color",
        "$value": "#1B1A17",
        "$description": "'AI-generated' label on staged images."
      },
      "aiLabelFg": { "$type": "color", "$value": "#FFFFFF" },
      "chipFill": {
        "$type": "color",
        "$value": "#ECE8DF",
        "$description": "Source chip (filled tone pill, no border) on the page ground."
      },
      "chipFillOnTrack": {
        "$type": "color",
        "$value": "#E6E1D6",
        "$description": "Source chip on track."
      },
      "chipFillOnClaim": {
        "$type": "color",
        "$value": "#E4DDCF",
        "$description": "Source chip on the claim field."
      },
      "emptyCell": {
        "$type": "color",
        "$value": "#EEEBE4",
        "$description": "Icon-array empty cell."
      },
      "emptyBorder": {
        "$type": "color",
        "$value": "#8C9199",
        "$description": "Border of empty icon-array cells and empty meter segments."
      },
      "meterOff": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Fill of an empty meter segment (artboard segOff/segEmpty)."
      },
      "segmentOn": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Selected segment of a segmented control, on track (artboard segOn)."
      },
      "slab": {
        "$type": "color",
        "$value": "#1B1A17",
        "$description": "Dark instrument stage (replay tower, slab bars)."
      },
      "onSlab": { "$type": "color", "$value": "#FBFAF7" },
      "onSlab2": { "$type": "color", "$value": "#CFCAC0" },
      "slabOff": { "$type": "color", "$value": "#E2DED4", "$description": "Unbuilt slab bars." },
      "scrim": {
        "$type": "color",
        "$value": "rgba(27, 26, 23, 0.42)",
        "$description": "The documented exception: a neutral scrim under text on a photo (DESIGN §0)."
      }
    },
    "night": {
      "bg": { "$type": "color", "$value": "#0B1411" },
      "bgSolid": { "$type": "color", "$value": "#0B1411" },
      "panel": { "$type": "color", "$value": "#16221D", "$description": "Artboard panelSolid." },
      "track": {
        "$type": "color",
        "$value": "#1C2522",
        "$description": "Was rgba(255,255,255,0.07); opaque value from the artboards."
      },
      "photo": { "$type": "color", "$value": "#1B2A24" },
      "claimBg": { "$type": "color", "$value": "#1D2621" },
      "nav": { "$type": "color", "$value": "#121D19" },
      "navIndicator": {
        "$type": "color",
        "$value": "#213D32",
        "$description": "rgba(110,231,183,0.16) flattened over nav."
      },
      "header": { "$type": "color", "$value": "#121C18" },
      "sheet": { "$type": "color", "$value": "#111D19" },
      "glass": { "$type": "color", "$value": "#111D19" },
      "onGlass": { "$type": "color", "$value": "#EEF3F0" },
      "pressed": { "$type": "color", "$value": "#1C2E27" },
      "disabledBg": {
        "$type": "color",
        "$value": "#232C29",
        "$description": "rgba(255,255,255,0.10) flattened over bg."
      },
      "disabledFg": { "$type": "color", "$value": "#B9C6C0" },
      "line": {
        "$type": "color",
        "$value": "#262E2B",
        "$description": "rgba(255,255,255,0.11) flattened over bg."
      },
      "lineStrong": {
        "$type": "color",
        "$value": "#4F5654",
        "$description": "rgba(255,255,255,0.28) flattened over bg."
      },
      "ink": { "$type": "color", "$value": "#EEF3F0" },
      "ink2": { "$type": "color", "$value": "#B9C6C0" },
      "muted": { "$type": "color", "$value": "#93A69D" },
      "inverse": { "$type": "color", "$value": "#EEF3F0" },
      "onInverse": { "$type": "color", "$value": "#0B1411" },
      "accent": { "$type": "color", "$value": "#6EE7B7", "$description": "Mint." },
      "onAccent": { "$type": "color", "$value": "#052E1F" },
      "accentText": { "$type": "color", "$value": "#6EE7B7" },
      "accentStrong": { "$type": "color", "$value": "#A7F3D0" },
      "accentSoft": {
        "$type": "color",
        "$value": "#172D25",
        "$description": "rgba(110,231,183,0.12) flattened over bg."
      },
      "onAccentSoft": { "$type": "color", "$value": "#CFF7E6" },
      "focus": { "$type": "color", "$value": "#6EE7B7" },
      "error": { "$type": "color", "$value": "#FF8A80" },
      "aiLabelBg": { "$type": "color", "$value": "#1B1A17" },
      "aiLabelFg": { "$type": "color", "$value": "#FFFFFF" },
      "chipFill": {
        "$type": "color",
        "$value": "#232C29",
        "$description": "rgba(255,255,255,0.10) flattened over bg."
      },
      "chipFillOnTrack": {
        "$type": "color",
        "$value": "#373F3D",
        "$description": "rgba(255,255,255,0.12) flattened over track."
      },
      "chipFillOnClaim": {
        "$type": "color",
        "$value": "#343C37",
        "$description": "rgba(255,255,255,0.10) flattened over claimBg."
      },
      "emptyCell": {
        "$type": "color",
        "$value": "#1A221F",
        "$description": "rgba(255,255,255,0.06) flattened over bg."
      },
      "emptyBorder": { "$type": "color", "$value": "#7D828A" },
      "meterOff": {
        "$type": "color",
        "$value": "transparent",
        "$description": "No fill: the segment shows its outline only."
      },
      "segmentOn": {
        "$type": "color",
        "$value": "#3C4441",
        "$description": "rgba(255,255,255,0.14) flattened over track."
      },
      "slab": { "$type": "color", "$value": "#13201B" },
      "onSlab": { "$type": "color", "$value": "#EEF3F0" },
      "onSlab2": { "$type": "color", "$value": "#B9C6C0" },
      "slabOff": {
        "$type": "color",
        "$value": "#28302E",
        "$description": "rgba(255,255,255,0.12) flattened over bg."
      },
      "scrim": { "$type": "color", "$value": "rgba(0, 0, 0, 0.58)" }
    }
  },
  "risk": {
    "$description": "Delivery-risk ramp (DESIGN §3.2). Never reuse these colours for anything else. Band names, frequencies and reasons are copy and come from the server, not from tokens.",
    "band": {
      "low": {
        "step": { "$type": "number", "$value": 1 },
        "meter": { "$type": "string", "$value": "solid" }
      },
      "moderate": {
        "step": { "$type": "number", "$value": 2 },
        "meter": { "$type": "string", "$value": "solid" }
      },
      "elevated": {
        "step": { "$type": "number", "$value": 3 },
        "meter": { "$type": "string", "$value": "solid" }
      },
      "high": {
        "step": { "$type": "number", "$value": 4 },
        "meter": { "$type": "string", "$value": "solid" }
      },
      "severe": {
        "step": { "$type": "number", "$value": 5 },
        "meter": { "$type": "string", "$value": "solid" }
      },
      "limited": {
        "step": { "$type": "number", "$value": 0 },
        "meter": {
          "$type": "string",
          "$value": "dashed",
          "$description": "Limited history: no band, a dashed meter in the band ink."
        }
      },
      "notScored": {
        "step": { "$type": "number", "$value": 0 },
        "meter": {
          "$type": "string",
          "$value": "outlined",
          "$description": "Not scored: an outlined meter, no fill."
        }
      }
    },
    "day": {
      "low": {
        "ink": { "$type": "color", "$value": "#4A90A4" },
        "fill": { "$type": "color", "$value": "#E6F2F5" },
        "text": {
          "$type": "color",
          "$value": "{color.day.ink}",
          "$description": "The Low ink fails 4.5:1 for text, so the name uses ink."
        }
      },
      "moderate": {
        "ink": { "$type": "color", "$value": "#9E8300" },
        "fill": { "$type": "color", "$value": "#F7F0D2" },
        "text": {
          "$type": "color",
          "$value": "{color.day.ink}",
          "$description": "The Moderate ink fails 4.5:1 for text, so the name uses ink."
        }
      },
      "elevated": {
        "ink": { "$type": "color", "$value": "#A9480C" },
        "fill": { "$type": "color", "$value": "#FBE6D8" },
        "text": { "$type": "color", "$value": "{risk.day.elevated.ink}" }
      },
      "high": {
        "ink": { "$type": "color", "$value": "#94211C" },
        "fill": { "$type": "color", "$value": "#F8DFDD" },
        "text": { "$type": "color", "$value": "{risk.day.high.ink}" }
      },
      "severe": {
        "ink": { "$type": "color", "$value": "#4A1445" },
        "fill": { "$type": "color", "$value": "#F0E1EE" },
        "text": { "$type": "color", "$value": "{risk.day.severe.ink}" }
      },
      "limited": {
        "ink": { "$type": "color", "$value": "#6B7079" },
        "fill": {
          "$type": "color",
          "$value": "{color.day.track}",
          "$description": "Limited history sits on track (DESIGN §0)."
        },
        "text": { "$type": "color", "$value": "{color.day.ink2}" }
      },
      "notScored": {
        "ink": { "$type": "color", "$value": "#8C9199" },
        "fill": { "$type": "color", "$value": "transparent" },
        "text": { "$type": "color", "$value": "{color.day.ink2}" }
      }
    },
    "night": {
      "low": {
        "ink": { "$type": "color", "$value": "#7CC0D2" },
        "fill": { "$type": "color", "$value": "#15323A" },
        "text": { "$type": "color", "$value": "{risk.night.low.ink}" }
      },
      "moderate": {
        "ink": { "$type": "color", "$value": "#D9BC45" },
        "fill": { "$type": "color", "$value": "#332B0C" },
        "text": { "$type": "color", "$value": "{risk.night.moderate.ink}" }
      },
      "elevated": {
        "ink": { "$type": "color", "$value": "#F08A4B" },
        "fill": { "$type": "color", "$value": "#3A2210" },
        "text": { "$type": "color", "$value": "{risk.night.elevated.ink}" }
      },
      "high": {
        "ink": { "$type": "color", "$value": "#F2706A" },
        "fill": { "$type": "color", "$value": "#3D1A19" },
        "text": { "$type": "color", "$value": "{risk.night.high.ink}" }
      },
      "severe": {
        "ink": { "$type": "color", "$value": "#D58BD0" },
        "fill": { "$type": "color", "$value": "#341A33" },
        "text": { "$type": "color", "$value": "{risk.night.severe.ink}" }
      },
      "limited": {
        "ink": { "$type": "color", "$value": "#A3A8B0" },
        "fill": { "$type": "color", "$value": "{color.night.track}" },
        "text": { "$type": "color", "$value": "{color.night.ink2}" }
      },
      "notScored": {
        "ink": { "$type": "color", "$value": "#7D828A" },
        "fill": { "$type": "color", "$value": "transparent" },
        "text": { "$type": "color", "$value": "{color.night.ink2}" }
      }
    }
  },
  "elevation": {
    "$description": "No shadows at rest. Only things that truly float (sheet, menu, dialog, drawer, floating map control) take this shadow (DESIGN §0, §3.4).",
    "day": {
      "sheet": {
        "$type": "shadow",
        "$value": {
          "color": "rgba(27, 26, 23, 0.12)",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        }
      }
    },
    "night": {
      "sheet": {
        "$type": "shadow",
        "$value": {
          "color": "rgba(0, 0, 0, 0.45)",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"],
        "$description": "Headlines, big numbers, band names. Weight 800, opsz axis. The app uses it only for display, title and section, at 700 (FOUNDER_QUESTIONS P10)."
      },
      "text": {
        "$type": "fontFamily",
        "$value": ["Mukta", "Noto Sans", "system-ui", "sans-serif"],
        "$description": "Web body, labels, buttons, tables. Weights 400–700. The web moves to `ui` (Figtree) in a follow-up (P10)."
      },
      "ui": {
        "$type": "fontFamily",
        "$value": ["Figtree", "Noto Sans", "system-ui", "sans-serif"],
        "$description": "Figtree (variable, OFL) for all text, buttons and labels; Noto Sans covers Devanagari (FOUNDER_QUESTIONS P10, 20 Oct 2026). The app's text roles use it now; the web adopts it in a follow-up."
      }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "numeric": {
      "$type": "string",
      "$value": "tabular-nums lining-nums",
      "$description": "font-variant-numeric on the root."
    }
  },
  "type": {
    "$description": "Type roles. web sizes are CSS px (emitted as rem); app sizes are Android sp. letterSpacing is in em. DESIGN §0 sets the public-page scale (hero, question, bodyPublic); §3.3 sets the rest. Five sizes on a page at most. Both platforms follow UI v2 (product/design/review/benchmark-thapki.md, FOUNDER_QUESTIONS P10): Figtree for text, buttons and labels; Bricolage Grotesque 700 (never 800) for display, title and section only. The web's `section` role (new) is the buyer-question section heading; `h3` and `number` moved from Bricolage to Figtree to match the app, keeping their existing sizes.",
    "web": {
      "hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "clamp(56px, 7.5vw, 112px)",
          "lineHeight": 0.94,
          "letterSpacing": "-0.045em"
        },
        "$description": "Public-page hero display (DESIGN §0). Bricolage 700 (P10), never 800."
      },
      "question": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "clamp(40px, 5vw, 64px)",
          "lineHeight": 1,
          "letterSpacing": "-0.035em"
        },
        "$description": "Public-page section question (DESIGN §0; artboards). Bricolage 700 (P10), never 800."
      },
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "52px",
          "lineHeight": 1.02,
          "letterSpacing": "-0.03em"
        }
      },
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "40px",
          "lineHeight": 1.08,
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "34px",
          "lineHeight": 1.1,
          "letterSpacing": "-0.02em"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "20px",
          "lineHeight": 1.25,
          "letterSpacing": "-0.01em"
        },
        "$description": "New (P10, benchmark-thapki.md): the buyer-question section heading used throughout a page's bands. Bricolage 700, 20/25. Replaces `h2` (34·800) for this use; `h2` itself stays for the rarer, larger heading."
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "24px",
          "lineHeight": 1.2,
          "letterSpacing": "-0.02em"
        },
        "$description": "Sub-heading inside a card or panel. Figtree (P10): Bricolage is for display, title/h1, h2 and section only."
      },
      "number": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "30px",
          "lineHeight": 1.1,
          "letterSpacing": "-0.02em"
        },
        "$description": "Big number on tiles; band name in the risk header (M). Figtree (P10)."
      },
      "numberLg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.bold}",
          "fontSize": "40px",
          "lineHeight": 1.1,
          "letterSpacing": "-0.02em"
        },
        "$description": "Big number on the risk card. Figtree (P10)."
      },
      "lead": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.normal}",
          "fontSize": "21px",
          "lineHeight": 1.4,
          "letterSpacing": "0em"
        }
      },
      "bodyPublic": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.normal}",
          "fontSize": "19px",
          "lineHeight": 1.55,
          "letterSpacing": "0em"
        },
        "$description": "Body on public pages: Home, Project, Developer, Methodology (DESIGN §0)."
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.normal}",
          "fontSize": "17px",
          "lineHeight": 1.55,
          "letterSpacing": "0em"
        }
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontWeight": "{font.weight.normal}",
          "fontSize": "15px",
          "lineHeight": 1.45,
          "letterSpacing": "0em"
        }
      },
      "caption": {
