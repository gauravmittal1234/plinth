{
  "name": "@plinth/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "React components shared by web and admin (RiskChip, Meter, IconArray, Riskometer, EvidenceDrawer...).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "echo '@plinth/web-ui ships TypeScript source; apps compile it (transpilePackages)'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plinth/contracts": "*",
    "@plinth/tokens": "*",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@plinth/config": "*",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest-axe": "^10.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
