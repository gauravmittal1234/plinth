{
  "name": "@plinth/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contracts: JSON Schema 2020-12, OpenAPI 3.1, catalogues -> TS types + ajv standalone validators, Dart (plinth_contracts), Python (plinth_contracts, Pydantic v2).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./validators": {
      "types": "./gen/ts/validators.d.ts",
      "default": "./gen/ts/validators.js"
    },
    "./schemas/*": "./schemas/*",
    "./catalogues/*": "./catalogues/*",
    "./examples/*": "./examples/*",
    "./openapi/plinth.yaml": "./openapi/plinth.yaml"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dart": "cd dart && dart pub get && dart analyze && dart test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@plinth/config": "*",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype": "^23.3.25",
    "yaml": "^2.9.1"
  }
}
