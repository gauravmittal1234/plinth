{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.in/schemas/ai/demand_letter.schema.json",
  "title": "DemandLetter",
  "description": "Response schema of extract.demand_letter@1, one reader's answer (BUILD_PLAN §14, F-92; pii_policy strip_and_redact_bank). A payment-demand letter read as a list of claims (stage, plan, amount, payee), the same shape as ai/marketing_claims.schema.json so agree() compares every extract.* reader uniformly (app.extracted_claims.claim_type, DATA_MODEL §7). No envelope: validated by the AI gateway directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/DemandLetterClaim" }
    }
  },
  "$defs": {
    "DemandLetterClaimType": {
      "title": "DemandLetterClaimType",
      "description": "app.extracted_claims.claim_type (DATA_MODEL §7).",
      "type": "string",
      "enum": [
        "possession_date",
        "price",
        "all_in",
        "area",
        "rera_number",
        "oc_status",
        "sold_left",
        "amenity",
        "demand_stage",
        "plan_stage",
        "amount",
        "payee_name",
        "account_number",
        "ifsc",
        "banned_phrase"
      ]
    },
    "DemandLetterClaimQualifier": {
      "title": "DemandLetterClaimQualifier",
      "type": "string",
      "enum": ["super", "carpet", "all_in", "base"]
    },
    "DemandLetterClaim": {
      "title": "DemandLetterClaim",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw_text", "value", "line_ids", "confidence"],
      "properties": {
        "type": { "$ref": "#/$defs/DemandLetterClaimType" },
        "raw_text": {
          "description": "The claim exactly as printed, before any normalisation.",
          "type": "string"
        },
        "value": {
          "description": "Normalised value. account_number carries the PII-vault token (e.g. \"[ACCOUNT_1]\"), never a raw digit.",
          "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "qualifier": {
          "anyOf": [{ "$ref": "#/$defs/DemandLetterClaimQualifier" }, { "type": "null" }]
        },
        "line_ids": {
          "description": "ai/ocr_page.schema.json OcrLine ids the claim was read from.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
