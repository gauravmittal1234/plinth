{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.in/schemas/ai/payment_request.schema.json",
  "title": "PaymentRequest",
  "description": "Response schema of extract.payment_request@1, one reader's answer (BUILD_PLAN §14, F-94; pii_policy strip_and_redact_bank). A forwarded payment request (WhatsApp image or text) read as a list of claims (payee, account, IFSC, amount), the same shape as ai/marketing_claims.schema.json so agree() compares every extract.* reader uniformly (app.extracted_claims.claim_type, DATA_MODEL §7). The rules (before_you_pay_check) decide the verdict, never a reader. No envelope: validated by the AI gateway directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/PaymentRequestClaim" }
    }
  },
  "$defs": {
    "PaymentRequestClaimType": {
      "title": "PaymentRequestClaimType",
      "description": "app.extracted_claims.claim_type (DATA_MODEL §7).",
      "type": "string",
      "enum": [
        "possession_date",
        "price",
        "all_in",
        "area",
        "rera_number",
        "oc_status",
        "sold_left",
        "amenity",
        "demand_stage",
        "plan_stage",
        "amount",
        "payee_name",
        "account_number",
        "ifsc",
        "banned_phrase"
      ]
    },
    "PaymentRequestClaimQualifier": {
      "title": "PaymentRequestClaimQualifier",
      "type": "string",
      "enum": ["super", "carpet", "all_in", "base"]
    },
    "PaymentRequestClaim": {
      "title": "PaymentRequestClaim",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw_text", "value", "line_ids", "confidence"],
      "properties": {
        "type": { "$ref": "#/$defs/PaymentRequestClaimType" },
        "raw_text": {
          "description": "The claim exactly as printed, before any normalisation.",
          "type": "string"
        },
        "value": {
          "description": "Normalised value. account_number carries the PII-vault token (e.g. \"[ACCOUNT_1]\"), never a raw digit.",
          "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "qualifier": {
          "anyOf": [{ "$ref": "#/$defs/PaymentRequestClaimQualifier" }, { "type": "null" }]
        },
        "line_ids": {
          "description": "ai/ocr_page.schema.json OcrLine ids the claim was read from.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
