{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.in/schemas/receipt.schema.json",
  "title": "Receipt",
  "description": "plinth.receipt/1, from api.receipt_add (API_CONTRACTS §3.2; app.receipts, DATA_MODEL §7). Typed in R1 (FOUNDER_QUESTIONS M3-12): amount, date and the last 4 UTR digits only, no AI reading. Kept until the user deletes it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "phase_slug", "amount_inr", "amount_label", "paid_on", "utr_last4", "line"],
  "properties": {
    "schema": { "const": "plinth.receipt/1" },
    "id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "phase_slug": { "$ref": "common.schema.json#/$defs/Slug" },
    "amount_inr": { "$ref": "common.schema.json#/$defs/Inr" },
    "amount_label": { "type": "string" },
    "paid_on": { "$ref": "common.schema.json#/$defs/IsoDate" },
    "utr_last4": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "payee_check_id": {
      "description": "The before_you_pay check this receipt follows up on, when there was one.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/Uuid" }, { "type": "null" }]
    },
    "line": {
      "description": "\"₹11,00,000 paid 18 Oct 2026 · UTR …7731\"",
      "type": "string"
    }
  },
  "$defs": {
    "ReceiptAddRequest": {
      "title": "ReceiptAddRequest",
      "description": "Arguments of api.receipt_add.",
      "type": "object",
      "additionalProperties": false,
      "required": ["p_slug", "p_amount_inr", "p_paid_on", "p_utr_last4"],
      "properties": {
        "p_slug": { "$ref": "common.schema.json#/$defs/Slug" },
        "p_upload_id": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/Uuid" }, { "type": "null" }]
        },
        "p_amount_inr": { "type": "integer", "minimum": 0 },
        "p_paid_on": { "$ref": "common.schema.json#/$defs/IsoDate" },
        "p_utr_last4": { "type": "string", "pattern": "^\\d{4}$" },
        "p_payee_check_id": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/Uuid" }, { "type": "null" }]
        },
        "p_client_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
