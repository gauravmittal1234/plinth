{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.in/schemas/doc_check.schema.json",
  "title": "DocCheck",
  "description": "plinth.doc_check/1, from api.doc_check(p_id) after the doc-check edge function (API_CONTRACTS §4.12; F-90, F-10, F-92, F-94, F-91). Nothing is checked before the buyer confirms the project. Verdicts come from rules, never from AI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "status",
    "doc_label",
    "project_match",
    "summary_line",
    "breakdown_line",
    "rows",
    "actions",
    "notes",
    "rules_version"
  ],
  "properties": {
    "schema": {
      "const": "plinth.doc_check/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "#/$defs/DocCheckKind"
    },
    "status": {
      "$ref": "#/$defs/DocCheckStatus"
    },
    "doc_label": {
      "type": ["string", "null"]
    },
    "project_match": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectMatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary_line": {
      "type": ["string", "null"]
    },
    "breakdown_line": {
      "type": ["string", "null"]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocCheckRow"
      }
    },
    "actions": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocCheckActions"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}$"
    },
    "cost": {
      "description": "kind = cost_sheet only.",
      "$ref": "cost_breakdown.schema.json"
    },
    "payee": {
      "description": "kind = before_you_pay only.",
      "$ref": "payee_check.schema.json#/$defs/PayeeResult"
    },
    "edge": {
      "description": "Set for an edge status (unreadable, partly_readable, no_claims, outside_coverage, checks_paused); null once status is confirm_project or done.",
      "anyOf": [{ "$ref": "#/$defs/DocCheckEdge" }, { "type": "null" }]
    },
    "project_candidates": {
      "description": "The pick list, when the match needs the buyer's confirmation (project_match.method user_pick and not yet confirmed).",
      "type": "array",
      "items": { "$ref": "#/$defs/ProjectCandidate" }
    },
    "stage": {
      "description": "kind = pay_as_built only: the tower chart (letter slab against filed slab).",
      "anyOf": [{ "$ref": "#/$defs/DocCheckStage" }, { "type": "null" }]
    },
    "recheck": {
      "description": "Set once a later filing could change this check's answer (FOUNDER_QUESTIONS M3-11).",
      "anyOf": [{ "$ref": "#/$defs/DocCheckRecheck" }, { "type": "null" }]
    },
    "saved": {
      "description": "True once api.doc_check_save was called; an unsaved check is deleted after 30 days.",
      "type": "boolean"
    },
    "share": {
      "anyOf": [{ "$ref": "#/$defs/DocCheckShare" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "$comment": "Rows exist only once the project is confirmed.",
      "if": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": ["reading", "confirm_project"]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "DocCheckKind": {
      "title": "DocCheckKind",
      "type": "string",
      "enum": ["claims", "cost_sheet", "pay_as_built", "before_you_pay", "visit_recap"]
    },
    "DocCheckStatus": {
      "title": "DocCheckStatus",
      "description": "Poll until the status is confirm_project, done, unreadable, no_claims, partly_readable, outside_coverage or checks_paused. checks_paused is the ai_doc_check kill switch (T61; catalogues/flags.json).",
      "type": "string",
      "enum": [
        "reading",
        "confirm_project",
        "checking",
        "done",
        "unreadable",
        "partly_readable",
        "no_claims",
        "outside_coverage",
        "checks_paused"
      ]
    },
    "MatchMethod": {
      "title": "MatchMethod",
      "type": "string",
      "enum": ["rera_number", "name_sector", "user_pick"]
    },
    "ProjectMatch": {
      "title": "ProjectMatch",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "method", "confirmed", "line"],
      "properties": {
        "slug": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "$ref": "#/$defs/MatchMethod"
        },
        "confirmed": {
          "type": "boolean"
        },
        "line": {
          "type": "string"
        }
      }
    },
    "DocCheckRow": {
      "title": "DocCheckRow",
      "description": "One claim (or stage, amount, payee) against the records.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "says_text", "verdict", "verdict_label", "records_line"],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "says_label": {
          "type": "string",
          "examples": ["Flyer says"]
        },
        "says_text": {
          "type": "string"
        },
        "verdict": {
          "$ref": "common.schema.json#/$defs/Verdict"
        },
        "verdict_label": {
          "type": "string"
        },
        "records_line": {
          "type": "string"
        },
        "records_label": {
          "description": "INTEGRATION_NOTES round 3: optional, e.g. \"Records show\", \"Price list shows\", \"Your plan shows\" (API_CONTRACTS §4.12).",
          "type": ["string", "null"],
          "examples": ["Records show", "Price list shows", "Your plan shows"]
        },
        "how_checked": {
          "type": ["string", "null"]
        },
        "review": {
          "description": "Set while a person checks this reading (concierge-first, FOUNDER_QUESTIONS M3-7): \"Can't check yet\" + \"A person is checking this reading.\"",
          "anyOf": [{ "$ref": "#/$defs/DocCheckReview" }, { "type": "null" }]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/SourceRef"
          }
        },
        "broker_question": {
          "type": ["string", "null"]
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "bbox": {
          "description": "[x0, y0, x1, y1] as fractions of the page.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "checkable_on": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "developer_says": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DeveloperSaysLine"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DocCheckReview": {
      "title": "DocCheckReview",
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "properties": {
        "line": {
          "type": "string",
          "minLength": 1,
          "examples": ["A person is checking this reading."]
        }
      }
    },
    "EdgeAction": {
      "title": "EdgeAction",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "action"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "description": "A code the client switches on, e.g. \"retry_upload\", \"pick_project\", \"talk_to_adviser\".",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "DocCheckEdge": {
      "title": "DocCheckEdge",
      "description": "Unreadable, partly readable, no claims, outside coverage or checks paused (FOUNDER_QUESTIONS M3-7, M3-13).",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "primary", "secondary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "primary": {
          "anyOf": [{ "$ref": "#/$defs/EdgeAction" }, { "type": "null" }]
        },
        "secondary": {
          "anyOf": [{ "$ref": "#/$defs/EdgeAction" }, { "type": "null" }]
        }
      }
    },
    "ProjectCandidate": {
      "title": "ProjectCandidate",
      "description": "One row of the pick list; the buyer's tap becomes api.doc_check_confirm(p_id, p_slug).",
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "label"],
      "properties": {
        "slug": { "$ref": "common.schema.json#/$defs/Slug" },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sector_line": {
          "type": ["string", "null"]
        }
      }
    },
    "DocCheckStage": {
      "title": "DocCheckStage",
      "description": "kind = pay_as_built: the letter's claimed slab against the latest filed slab.",
      "type": "object",
      "additionalProperties": false,
      "required": ["letter_slab_line", "filed_slab_line", "floors", "as_of_line"],
      "properties": {
        "letter_slab_line": {
          "type": "string",
          "examples": ["This letter: slab 12"]
        },
        "filed_slab_line": {
          "type": "string",
          "examples": ["Latest filing: slab 9"]
        },
        "floors": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "as_of_line": {
          "type": "string",
          "examples": ["As of the Jan–Mar 2026 QPR, filed 15 Apr 2026."]
        }
      }
    },
    "DocCheckRecheck": {
      "title": "DocCheckRecheck",
      "type": "object",
      "additionalProperties": false,
      "required": ["armed", "line"],
      "properties": {
        "armed": {
          "description": "True once a later filing changed this check's answer; the re-check line and the check_updated alert follow.",
          "type": "boolean"
        },
        "line": {
          "type": ["string", "null"]
        }
      }
    },
    "DocCheckShare": {
      "title": "DocCheckShare",
      "type": "object",
      "additionalProperties": false,
      "required": ["card_url", "card_alt", "share_text"],
      "properties": {
        "card_url": {
          "type": "string",
          "minLength": 1
        },
        "card_alt": {
          "type": "string",
          "minLength": 1
        },
        "share_text": {
          "description": "A summary only, never the file.",
          "type": "string"
        }
      }
    },
    "DocCheckActions": {
      "title": "DocCheckActions",
      "type": "object",
      "additionalProperties": false,
      "required": ["share_text", "broker_questions"],
      "properties": {
        "share_text": {
          "type": "string",
          "description": "A summary only, never the file."
        },
        "broker_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DocCheckStartRequest": {
      "title": "DocCheckStartRequest",
      "description": "POST /functions/v1/doc-check body, after api.create_upload and the PUT of the file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["upload_id", "kind", "channel", "phase_hint"],
      "properties": {
        "upload_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "kind": {
          "$ref": "#/$defs/DocCheckKind"
        },
        "channel": {
          "$ref": "common.schema.json#/$defs/Channel"
        },
        "phase_hint": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Slug"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DocCheckStarted": {
      "title": "DocCheckStarted",
      "description": "202 reply of the doc-check edge function. An acknowledgement, so no schema envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "poll_after_ms"],
      "properties": {
        "check_id": {
          "$ref": "common.schema.json#/$defs/Uuid"
        },
        "status": {
          "$ref": "#/$defs/DocCheckStatus"
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
