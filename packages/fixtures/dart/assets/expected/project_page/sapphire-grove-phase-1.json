  "before_booking": {
    "intro_line": "Four things buyers ask about before the first cheque, with the rules behind them.",
    "note_line": "General information, not legal, tax or financial advice.",
    "payment_plans": {
      "title": "Which payment plan?",
      "sub": "Construction-linked, down payment or subvention, and what each one risks.",
      "paras": [
        {
          "lead": "Construction-linked.",
          "text": "You pay each stage once it is built, so your money follows the building. Check each demand against the latest QPR.",
          "tone": "body"
        },
        {
          "lead": "Down payment.",
          "text": "You pay most of the price early, often for a discount. If the project is late, more of your money waits with it. Before a registered agreement, the law still caps you at 10%.",
          "tone": "body"
        },
        {
          "lead": "Subvention, or “no EMI till possession”.",
          "text": "The bank pays the developer early, and the developer promises to pay your pre-EMI. You are still the borrower: if the developer stops paying, the bank collects from you.",
          "tone": "body"
        },
        {
          "lead": "Before a subvention booking,",
          "text": "get the lender's confirmation in writing: what it pays out, when, and who pays the pre-EMI if the developer stops.",
          "tone": "key"
        }
      ]
    },
    "loans": {
      "line": "Loan checks arrive in 2027",
      "title": "Home loans",
      "sub": "Loan checks arrive in 2027. What to check with your bank now.",
      "paras": [
        {
          "lead": "Loan checks arrive in 2027.",
          "text": "Plinth doesn't arrange loans or pass your number to any lender today.",
          "tone": "body"
        },
        {
          "lead": "Check now:",
          "text": "is this project approved by your bank? Ask the bank, in writing, not the developer.",
          "tone": "key"
        },
        {
          "lead": "Banks usually don't lend for stamp duty or registration.",
          "text": "Plan for those from your own money.",
          "tone": "body"
        }
      ]
    },
    "nri": {
      "title": "Buying from abroad (NRI)",
      "sub": "Paying from NRE or NRO, a power of attorney, and FEMA basics.",
      "paras": [
        {
          "lead": "Paying.",
          "text": "From an NRE, FCNR(B) or NRO account, or money sent to India through a bank. FEMA doesn't allow paying in foreign currency notes or traveller's cheques.",
          "tone": "body"
        },
        {
          "lead": "Loans.",
          "text": "Indian banks lend to NRIs. EMIs come from an NRE or NRO account.",
          "tone": "body"
        },
        {
          "lead": "TDS.",
          "text": "Like any buyer, you deduct 1% from each instalment when the price is ₹50 L or more (s.194-IA). You need a PAN.",
          "tone": "body"
        },
        {
          "lead": "Power of attorney.",
          "text": "Make it specific to this flat, and list what your relative may sign: booking form, agreement, payments, registration. One signed abroad is attested at an Indian mission or apostilled, then stamped in India within 3 months.",
          "tone": "body"
        }
      ]
    },
    "selling_before_possession": {
      "title": "Selling before possession",
      "sub": "Transfer charges, the builder's NOC and what RERA says.",
      "paras": [
        {
          "lead": null,
          "text": "Selling before possession means transferring your allotment. The developer endorses the new buyer on your agreement and issues a no-objection certificate (NOC).",
          "tone": "body"
        },
        {
          "lead": "Under RERA,",
          "text": "whoever takes your allotment becomes the allottee, with your rights, including delay interest (s.2(d)).",
          "tone": "body"
        },
        {
          "lead": "Ask a CA",
          "text": "about capital-gains tax, and a lawyer about stamp duty on the transfer.",
          "tone": "body"
        },
        {
          "lead": null,
          "text": "Our resale and transfer checks are planned for Apr–Jun 2027.",
          "tone": "body"
        }
      ]
    }
  },
