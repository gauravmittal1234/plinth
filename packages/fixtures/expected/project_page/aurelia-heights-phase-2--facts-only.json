    "nri": {
      "title": "Buying from abroad (NRI)",
      "sub": "Paying from NRE or NRO, a power of attorney, and FEMA basics.",
      "paras": [
        {
          "lead": "Paying.",
          "text": "From an NRE, FCNR(B) or NRO account, or money sent to India through a bank. FEMA doesn't allow paying in foreign currency notes or traveller's cheques.",
          "tone": "body"
        },
        {
          "lead": "Loans.",
          "text": "Indian banks lend to NRIs. EMIs come from an NRE or NRO account.",
          "tone": "body"
        },
        {
          "lead": "TDS.",
          "text": "Like any buyer, you deduct 1% from each instalment when the price is ₹50 L or more (s.194-IA). You need a PAN.",
          "tone": "body"
        },
        {
          "lead": "Power of attorney.",
          "text": "Make it specific to this flat, and list what your relative may sign: booking form, agreement, payments, registration. One signed abroad is attested at an Indian mission or apostilled, then stamped in India within 3 months.",
          "tone": "body"
        }
      ]
