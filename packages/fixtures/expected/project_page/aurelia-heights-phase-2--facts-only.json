        },
        {
          "lead": "Check now:",
          "text": "is this project approved by your bank? Ask the bank, in writing, not the developer.",
          "tone": "key"
        },
        {
          "lead": "Developer says · brochure, 2 Oct 2026 · not verified:",
          "text": "“Approved by major banks.”",
          "tone": "developer_says"
        },
        {
          "lead": "Banks usually don't lend for stamp duty or registration.",
          "text": "Plan for those from your own money.",
          "tone": "body"
        }
