{
  "lock": false,
  "nodeModulesDir": "none",
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "imports": {
    "ajv": "npm:ajv@8.20.0"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check .",
    "test": "deno test --allow-env --allow-read --no-prompt",
    "verify": "deno fmt --check && deno lint && deno check . && deno test --allow-env --allow-read --no-prompt"
  }
}
